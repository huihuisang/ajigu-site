---
import { migrateContent } from "@ajigu/site-kit/urls";
import pages from "../content/home.json";
import SiteLayout from "@ajigu/site-kit/layouts/SiteLayout.astro";
import { SiteHeader } from "@ajigu/site-kit/components/SiteHeader";
import { GalleryCard } from "@ajigu/site-kit/components/GalleryCard";
import { DisplayTitle } from "@ajigu/site-kit/components/DisplayTitle";
import { SiteFooter } from "@ajigu/site-kit/components/SiteFooter";
import { getCopy } from "@ajigu/site-kit/copy";

import gallery from "../content/gallery.json";
import productFacts from "../content/product-facts.json";
import "../styles/gallery.css";

interface Props {
  page: (typeof pages)[number];
}
const page = migrateContent(Astro.props.page);
const copy = getCopy(page.locale);
const availabilityDate = (id: keyof typeof productFacts) => {
  const facts = productFacts[id];
  return facts.releaseDate ?? ("publicBetaDate" in facts ? facts.publicBetaDate : "");
};
const products = page.products.toSorted((left, right) =>
  availabilityDate(right.id as keyof typeof productFacts).localeCompare(
    availabilityDate(left.id as keyof typeof productFacts),
  ),
);
---

<SiteLayout metadata={page.metadata} locale={page.locale} languages={page.languages} gallery>
  <a class="studio-skip" href="#main">
    {copy.skip}
  </a>
  <SiteHeader
    client:load
    name="ajigu"
    icon="/assets/logo.webp"
    route={page.route}
    home
    minimal
    copy={copy}
    languages={page.languages}
    language={page.locale}
  />
  <main id="main" class="gallery-main studio-shell">
    <section class="gallery-intro" id="studio" data-enter>
      <h1>
        <DisplayTitle text={page.headline} />
      </h1>
      <p>{page.about}</p>
    </section>
    <section id="apps" class="work-gallery" aria-label={copy.work}>
      {products.map((product) => (
        <GalleryCard
          id={product.id}
          name={product.name}
          href={product.url}
          platform={product.platform}
          description={product.description}
          file={gallery[product.id as keyof typeof gallery].file}
          facts={productFacts[product.id as keyof typeof productFacts]}
          copy={copy.gallery}
        />
      ))}
    </section>
  </main>
  <div id="contact">
    <SiteFooter signatureLabel={copy.signatureLabel} client:load links={page.contactLinks} />
  </div>
</SiteLayout>
