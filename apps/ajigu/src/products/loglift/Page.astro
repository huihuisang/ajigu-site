---
import ProductLanding from "@ajigu/site-kit/layouts/ProductLanding.astro";
import pages from "./content/pages.json";
import product from "./content/product.json";

interface Props {
  page: (typeof pages)[number];
}
const { page } = Astro.props;
---

<ProductLanding page={page} product={product}>
  <figure slot="demo" class="loglift-preview">
    <img
      src="/studio/screens/loglift-home.webp"
      alt={page.previewAlt}
      width="2560"
      height="1800"
      loading="lazy"
      decoding="async"
    />
    <figcaption>{page.previewCaption}</figcaption>
  </figure>
</ProductLanding>

<style>
  .loglift-preview {
    margin: 0;
  }
  .loglift-preview img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
  }
  .loglift-preview figcaption {
    margin-top: 12px;
    color: var(--muted-foreground);
    font-size: 13px;
  }
</style>
