    "sections": [
      {
        "id": "features",
        "title": "Erase like it never happened.",
        "body": "<p>TUTU pairs smart object detection with an image-restoration model that runs entirely on your device.</p>",
        "items": [
          {
            "title": "Tap to erase",
            "body": "<p>Tap any object and TUTU finds its outline automatically—no careful tracing, no masks. One tap, and it&#x27;s history.</p>"
          },
          {
            "title": "Brush, line & box",
            "body": "<p>For anything you&#x27;d rather paint over—blemishes, cables, stains—precise brush, line, and rectangle tools are right there.</p>"
          },
          {
            "title": "Auto remove",
            "body": "<p>Lift your finger and TUTU cleans up the marked area automatically, filling it with what belongs there instead.</p>"
          },
          {
            "title": "Private by design",
            "body": "<p>Detection and inpainting run entirely on your iPhone. No account, no uploads, no tracking—your photos stay yours.</p>"
          },
          {
            "title": "Tunable detection",
            "body": "<p>Adjust the sensitivity to sweep up tiny clutter or grab whole objects—TUTU adapts to the scene you&#x27;re fixing.</p>"
          },
          {
            "title": "Save & keep going",
            "body": "<p>Export straight back to your photo library in full quality, and keep erasing until the frame feels right.</p>"
          }
        ],
        "links": []
      },
      {
        "id": "how",
        "title": "Three steps to a cleaner frame.",
        "body": "",
        "items": [
          {
            "title": "Pick a photo",
            "body": "<p>Tap or drag any picture in from your library.</p>"
          },
          {
            "title": "Mark what should go",
            "body": "<p>Tap an object, or brush over an area—your call.</p>"
          },
          {
            "title": "AI does the rest",
            "body": "<p>The scene is rebuilt in place. Save it back to your album.</p>"
          }
        ],
        "links": []
      },
