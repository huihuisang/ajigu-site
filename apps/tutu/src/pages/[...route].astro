---
import pages from "../content/pages.json";
import product from "../content/product.json";
import ProductLanding from "@ajigu/site-kit/layouts/ProductLanding.astro";
import ComparisonPreview from "../components/ComparisonPreview";

export function getStaticPaths() {
  return pages.map((page) => ({
    params: { route: page.route.slice(1, -1) || undefined },
    props: { page },
  }));
}
interface Props {
  page: (typeof pages)[number];
}
const { page } = Astro.props;
---

<ProductLanding page={page} product={product}>
  <ComparisonPreview
    slot="demo"
    locale={page.locale}
    aspect={product.comparison.aspect}
    offset={product.comparison.offset}
    client:load
  />
</ProductLanding>
