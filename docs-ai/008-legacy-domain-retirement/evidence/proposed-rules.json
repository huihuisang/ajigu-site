[
  {
    "description": "Legacy apps: shared resources",
    "expression": "(http.host in {\"typenote.ajigu.com\" \"moodsk.ajigu.com\" \"gosleep.ajigu.com\" \"dailyapod.ajigu.com\" \"tutu.ajigu.com\"} and (http.request.uri.path eq \"/studio\" or starts_with(http.request.uri.path, \"/studio/\") or http.request.uri.path eq \"/licenses\" or starts_with(http.request.uri.path, \"/licenses/\")))",
    "action": "redirect",
    "action_parameters": {
      "from_value": {
        "target_url": {
          "expression": "concat(\"https://ajigu.com\", http.request.uri.path)"
        },
        "status_code": 301,
        "preserve_query_string": true
      }
    },
    "enabled": true
  },
