{
  "domain": "ajigu.com",
  "plan": "free",
  "availableRedirectRules": 10,
  "usedRedirectRules": 1,
  "rules": [
    {
      "description": "www to apex",
      "expression": "(http.host eq \"www.ajigu.com\")",
      "action": "redirect",
      "action_parameters": {
        "from_value": {
          "target_url": {
            "expression": "concat(\"https://ajigu.com\", http.request.uri.path)"
          },
          "status_code": 301,
          "preserve_query_string": true
        }
      },
      "enabled": true
    }
  ]
}
